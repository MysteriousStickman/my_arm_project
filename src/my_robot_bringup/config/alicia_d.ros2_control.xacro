<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="alicia_d_ros2_control"
    params="name initial_positions_file use_fake_hardware hw_port hw_gripper_type hw_default_speed_deg_s">
    <xacro:property
      name="initial_positions"
      value="${xacro.load_yaml(initial_positions_file)['initial_positions']}" />

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <plugin>alicia_d_driver/AliciaDHardwareInterface</plugin>
          <param name="port">${hw_port}</param>
          <param name="gripper_type">${hw_gripper_type}</param>
          <param name="default_speed_deg_s">${hw_default_speed_deg_s}</param>
        </xacro:unless>
      </hardware>

      <xacro:macro name="alicia_d_joint_interfaces" params="joint_name">
        <joint name="${joint_name}">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <state_interface name="position">
            <param name="initial_value">${initial_positions[joint_name]}</param>
          </state_interface>
          <state_interface name="velocity" />
        </joint>
      </xacro:macro>

      <xacro:alicia_d_joint_interfaces joint_name="Joint1" />
      <xacro:alicia_d_joint_interfaces joint_name="Joint2" />
      <xacro:alicia_d_joint_interfaces joint_name="Joint3" />
      <xacro:alicia_d_joint_interfaces joint_name="Joint4" />
      <xacro:alicia_d_joint_interfaces joint_name="Joint5" />
      <xacro:alicia_d_joint_interfaces joint_name="Joint6" />
      <xacro:alicia_d_joint_interfaces joint_name="Gripper" />
    </ros2_control>
  </xacro:macro>
</robot>
